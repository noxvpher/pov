# La función y la clave PÚBLICA (van al navegador). Del panel:
# Integración → Claves, y Programación → Código.
POV_BASE_URL=https://pov.uy
POV_SHOWTIME=shw_pegá_la_tuya
POV_PUBLIC_KEY=pk_test_pegá_la_tuya

# La clave SECRETA es tuya y no sale del servidor. Sacala de tu panel:
# Integración → Claves → crear una `sk_test_`.
# Sin esto el widget se ve igual, pero la venta no se cierra.
POV_SECRET_KEY=sk_test_pegá_la_tuya

# Sólo para el receptor de webhooks (Integración → Webhooks).
POV_WEBHOOK_SECRET=whsec_pegá_el_tuyo

PORT=4000
