# Públicas: terminan en el bundle del navegador, y está bien que así sea.
NEXT_PUBLIC_POV_BASE_URL=https://pov.uy
NEXT_PUBLIC_POV_SHOWTIME=shw_pegá_la_tuya
NEXT_PUBLIC_POV_PUBLIC_KEY=pk_test_pegá_la_tuya

# SIN `NEXT_PUBLIC_`. Cualquier variable con ese prefijo se inlinea en el bundle, y una clave
# secreta en el bundle es una clave publicada.
POV_SECRET_KEY=sk_test_pegá_la_tuya
POV_WEBHOOK_SECRET=whsec_pegá_el_tuyo
